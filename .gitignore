# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Generated kubeconfig and rules
terraform/environments/local/kubeconfig
k8s/tests/.generated-rules.yaml

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Editors / OS
.idea/
.vscode/
.DS_Store

# Lock files are committed for root configurations only
terraform/modules/**/.terraform.lock.hcl
